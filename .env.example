# Application operating mode: "demo" uses local reactive state; "production" calls VITE_API_BASE_URL
VITE_APP_MODE="demo"

# Backend API base URL for production integration
VITE_API_BASE_URL="https://api.example.com/v1"

# Optional third-party frontend SDK public keys (never place secret keys here)
VITE_PAYMENT_GATEWAY_PUBLIC_KEY=""
VITE_MAPS_PUBLIC_KEY=""

# Server-side environment variables
APP_URL="MY_APP_URL"
